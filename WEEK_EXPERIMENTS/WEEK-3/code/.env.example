# Copy this file to .env. Never share or commit .env.
# Local MongoDB: set MONGODB_URI="mongodb://localhost:27017/" in .env.
# To switch back to Atlas, restore your mongodb+srv:// URI; no data is moved.
# Copy the Python driver URI from Atlas and replace the credential placeholders.
# Percent-encode special characters in the username/password, not the whole URI.
MONGODB_URI="mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DATABASE="llm_monitoring"
MONGODB_COLLECTION="call_logs"

GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"

# Optional: Ollama requires a local service; Gemini does not.
OLLAMA_MODEL="llama3.2"
